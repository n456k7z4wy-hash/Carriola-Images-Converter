<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!-- Importar no fim do CarriolaConverter.csproj, antes de </Project>. -->
  <PropertyGroup>
    <AssemblyTitle>Carriola Images Converter</AssemblyTitle>
    <Product>Carriola Images Converter</Product>
    <Description>Conversão de imagens em lote, com prévia, qualidade e redimensionamento.</Description>
    <ApplicationIcon>Assets\CarriolaConverter.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <!-- Evita duplicar as imagens que o modelo WinUI já inclui. -->
