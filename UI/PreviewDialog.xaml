<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="CarriolaConverter.PreviewDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Antes e depois" CloseButtonText="Fechar" DefaultButton="Close"
    RequestedTheme="Dark" Opened="Dialog_Opened" Closing="Dialog_Closing">
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">1080</x:Double>
    </ContentDialog.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="14" MinWidth="280">
            <TextBlock x:Name="FileNameText" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
            <StackPanel x:Name="LoadingPanel" Orientation="Horizontal" Spacing="12">
                <ProgressRing IsActive="True" Width="24" Height="24" />
                <TextBlock Text="Preparando a comparação…" VerticalAlignment="Center" />
            </StackPanel>
            <InfoBar x:Name="PreviewNotice" IsOpen="False" IsClosable="False" />
            <Grid x:Name="Comparison" ColumnSpacing="16" Visibility="Collapsed">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock Text="Original" FontWeight="SemiBold" Margin="0,0,0,8" />
                <TextBlock x:Name="AfterTitle" Grid.Column="1" Text="Convertida" FontWeight="SemiBold" Margin="0,0,0,8" />
                <ScrollViewer x:Name="BeforeViewer" Grid.Row="1" Height="340"
                    ZoomMode="Enabled" MinZoomFactor="1" MaxZoomFactor="4"
                    HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                    ViewChanged="Viewer_ViewChanged">
                    <Image x:Name="BeforeImage" Width="420" Height="320" Stretch="Uniform"
                           AutomationProperties.Name="Imagem original" />
                </ScrollViewer>
                <ScrollViewer x:Name="AfterViewer" Grid.Column="1" Grid.Row="1" Height="340"
                    ZoomMode="Enabled" MinZoomFactor="1" MaxZoomFactor="4"
                    HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                    ViewChanged="Viewer_ViewChanged">
                    <Image x:Name="AfterImage" Width="420" Height="320" Stretch="Uniform"
                           AutomationProperties.Name="Imagem após a conversão" />
                </ScrollViewer>
                <TextBlock x:Name="BeforeInfo" Grid.Row="2" Margin="0,8,0,0" TextWrapping="Wrap" />
                <TextBlock x:Name="AfterInfo" Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" TextWrapping="Wrap" />
            </Grid>
            <StackPanel x:Name="ZoomPanel" Spacing="6" Visibility="Collapsed">
                <TextBlock x:Name="ZoomText" Text="Zoom da prévia: 1×" />
                <Slider x:Name="ZoomSlider" Minimum="1" Maximum="4" Value="1" StepFrequency="0.25"
                        ValueChanged="Zoom_ValueChanged" AutomationProperties.Name="Zoom das duas prévias" />
                <TextBlock x:Name="SavingsText" Foreground="#B6A0FF" FontWeight="SemiBold" />
                <TextBlock x:Name="PreviewHint" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                <TextBlock Text="O quadriculado representa transparência. O zoom amplia a prévia; os tamanhos acima são os dos arquivos reais."
                           FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
