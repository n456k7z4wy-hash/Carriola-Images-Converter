<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="CarriolaConverter.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CarriolaConverter"
    Title="Carriola Images Converter">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root" RequestedTheme="Dark" Background="#18000000"
          Loaded="Root_Loaded">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="V" Modifiers="Control" Invoked="Paste_Invoked" />
        </Grid.KeyboardAccelerators>
        <Grid.Resources>
            <ImageBrush x:Key="ThumbnailBackground" Stretch="UniformToFill" />
            <SolidColorBrush x:Key="AccentBrush" Color="#B6A0FF" />
            <SolidColorBrush x:Key="SubtleBrush" Color="#ACADB8" />
            <SolidColorBrush x:Key="CardBrush" Color="#60272730" />
            <SolidColorBrush x:Key="OutlineBrush" Color="#24FFFFFF" />

            <Style TargetType="Button">
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="16,10" />
            </Style>
            <Style TargetType="ProgressBar">
                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                <Setter Property="Background" Value="#22FFFFFF" />
                <Setter Property="MinHeight" Value="4" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Background="Transparent">
            <Image Source="ms-appx:///Assets/Square44x44Logo.png"
                   Width="20" Height="20" Margin="24,0,0,0"
                   HorizontalAlignment="Left" VerticalAlignment="Center"
                   IsHitTestVisible="False" />
            <TextBlock Text="CARRIOLA IMAGES CONVERTER" Margin="56,0,150,0"
                       VerticalAlignment="Center" FontSize="11"
                       CharacterSpacing="120" Foreground="{StaticResource SubtleBrush}"
                       TextTrimming="CharacterEllipsis" />
        </Grid>

        <Grid x:Name="MainContent" Grid.Row="1" Margin="28,12,28,24"
              RowSpacing="18" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition IsStaggeringEnabled="False" />
                </TransitionCollection>
            </Grid.ChildrenTransitions>

            <StackPanel Spacing="5">
                <TextBlock Text="Suas imagens. Do seu jeito." FontSize="28"
                           FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="Converta, compare e encontre o tamanho ideal para suas imagens."
                           Foreground="{StaticResource SubtleBrush}" TextWrapping="Wrap" />
            </StackPanel>

            <InfoBar x:Name="Notice" Grid.Row="1" IsOpen="False"
                     IsClosable="True" Severity="Informational" />

            <Grid Grid.Row="2" ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="SettingsColumn" Width="320" />
                </Grid.ColumnDefinitions>

                <Grid RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border x:Name="DropZone" AllowDrop="True"
                            DragOver="DropZone_DragOver" DragLeave="DropZone_DragLeave"
                            Drop="DropZone_Drop" CornerRadius="20" Padding="20"
                            BorderBrush="{StaticResource OutlineBrush}" BorderThickness="1"
                            Background="{StaticResource CardBrush}" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="DropScale" />
                        </Border.RenderTransform>
                        <StackPanel Spacing="10" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE8B9;" FontSize="28"
                                      Foreground="{StaticResource AccentBrush}" />
                            <TextBlock x:Name="DropTitle" Text="Arraste imagens ou pastas para cá"
                                       FontSize="17" FontWeight="SemiBold"
                                       TextAlignment="Center" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <Button x:Name="AddButton" Content="Imagens" Click="Add_Click" />
                                <Button x:Name="AddFolderButton" Content="Pasta" Click="AddFolder_Click" />
                                <Button x:Name="PasteButton" Content="Colar" Click="Paste_Click"
                                        ToolTipService.ToolTip="Colar imagens ou arquivos copiados · Ctrl+V" />
                            </StackPanel>
                            <CheckBox x:Name="SubfoldersCheck" Content="Incluir imagens das subpastas"
                                      Checked="Setting_Changed" Unchecked="Setting_Changed" />
                            <TextBlock Text="JPG, PNG, WEBP, AVIF, HEIC, RAW e outros"
                                       FontSize="11" Foreground="{StaticResource SubtleBrush}"
                                       TextWrapping="Wrap" TextAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="1" Spacing="8">
                        <Grid>
                            <TextBlock x:Name="CountText" Text="Sua fila está vazia"
                                       VerticalAlignment="Center" FontWeight="SemiBold" />
                            <Button x:Name="ClearButton" Content="Limpar fila" Padding="10,5"
                                    HorizontalAlignment="Right" Click="Clear_Click" IsEnabled="False" />
                        </Grid>
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <ComboBox x:Name="FilterBox" SelectedIndex="0" SelectionChanged="Filter_SelectionChanged"
                                      AutomationProperties.Name="Filtrar a fila" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="Todas as imagens" />
                                <ComboBoxItem Content="Pendentes" />
                                <ComboBoxItem Content="Concluídas" />
                                <ComboBoxItem Content="Com erro" />
                            </ComboBox>
                            <Button x:Name="RemoveSelectedButton" Grid.Column="1" Content="Remover seleção"
                                    Click="RemoveSelected_Click" IsEnabled="False" Padding="10,5" />
                        </Grid>
                    </StackPanel>

                    <Border Grid.Row="2" CornerRadius="16" Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource OutlineBrush}" BorderThickness="1">
                        <Grid>
                            <StackPanel x:Name="EmptyState" Margin="24" Spacing="8"
                                        VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock x:Name="EmptyTitle" Text="Tudo começa com uma imagem" FontWeight="SemiBold"
                                           TextAlignment="Center" TextWrapping="Wrap" />
                                <TextBlock x:Name="EmptyHint" Text="Adicione uma foto ou selecione várias de uma vez."
                                           Foreground="{StaticResource SubtleBrush}" FontSize="12"
                                           TextAlignment="Center" TextWrapping="Wrap" />
                            </StackPanel>

                            <!-- A lista fica em uma linha de altura limitada para manter a virtualização. -->
                            <ListView x:Name="QueueList" SelectionMode="Multiple"
                                      SelectionChanged="Queue_SelectionChanged"
                                      ContainerContentChanging="Queue_ContainerContentChanging"
                                      IsItemClickEnabled="False" Padding="8"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="10,10" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:QueueItem">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="64" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Button Width="64" Height="64" Padding="0" Tag="{x:Bind}" Click="Preview_Click"
                                                    IsEnabled="{x:Bind CanPreview, Mode=OneWay}"
                                                    ToolTipService.ToolTip="Comparar antes e depois"
                                                    AutomationProperties.Name="Abrir comparação da imagem">
                                                <Grid Width="62" Height="62" Background="{StaticResource ThumbnailBackground}">
                                                    <FontIcon Glyph="&#xE91B;" FontSize="20" Foreground="White"
                                                              Opacity="{x:Bind PlaceholderOpacity, Mode=OneWay}" />
                                                    <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="Uniform" />
                                                </Grid>
                                            </Button>
                                            <StackPanel Grid.Column="1" Spacing="5">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                               ToolTipService.ToolTip="{x:Bind Source}" />
                                                    <TextBlock Grid.Column="1" Text="{x:Bind PercentText, Mode=OneWay}" FontSize="12" Opacity="0.7" />
                                                </Grid>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{x:Bind SizeText, Mode=OneWay}" FontSize="12" Opacity="0.8" />
                                                    <TextBlock Text="{x:Bind DifferenceText, Mode=OneWay}" FontSize="12" Foreground="{StaticResource AccentBrush}" />
                                                </StackPanel>
                                                <ProgressBar Minimum="0" Maximum="100" Value="{x:Bind Percent, Mode=OneWay}"
                                                             AutomationProperties.Name="Progresso do arquivo" />
                                                <TextBlock Text="{x:Bind Message, Mode=OneWay}" FontSize="12" Opacity="0.7"
                                                           ToolTipService.ToolTip="{x:Bind Message, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Button Grid.Column="2" Tag="{x:Bind}" Click="Remove_Click" Padding="8"
                                                    IsEnabled="{x:Bind CanRemove, Mode=OneWay}" VerticalAlignment="Top"
                                                    ToolTipService.ToolTip="Remover da fila" AutomationProperties.Name="Remover imagem da fila">
                                                <FontIcon Glyph="&#xE711;" FontSize="12" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Column="1" CornerRadius="20" Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource OutlineBrush}" BorderThickness="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="SettingsPanel" Padding="18" Spacing="16">
                            <TextBlock Text="Como você quer salvar?" FontSize="18"
                                       FontWeight="SemiBold" TextWrapping="Wrap" />

                            <ComboBox x:Name="FormatBox" Header="Formato de saída"
                                      PlaceholderText="Carregando formatos…" DisplayMemberPath="Name"
                                      HorizontalAlignment="Stretch" IsEnabled="False"
                                      SelectionChanged="Format_SelectionChanged" />

                            <StackPanel Spacing="6">
                                <Grid>
                                    <TextBlock Text="Qualidade" />
                                    <TextBlock x:Name="QualityText" Text="85%" HorizontalAlignment="Right"
                                               Foreground="{StaticResource AccentBrush}" />
                                </Grid>
                                <Slider x:Name="QualitySlider" Minimum="1" Maximum="100" Value="85"
                                        StepFrequency="1" TickFrequency="1" IsThumbToolTipEnabled="True"
                                        ValueChanged="Quality_ValueChanged"
                                        AutomationProperties.Name="Qualidade da imagem" />
                                <TextBlock x:Name="QualityHint" Text="Um equilíbrio entre tamanho e detalhes."
                                           FontSize="12" Foreground="{StaticResource SubtleBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <Expander Header="Tamanho da imagem" HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Stretch">
                                <StackPanel Spacing="10">
                                    <ComboBox x:Name="ResizeModeBox" SelectedIndex="0" HorizontalAlignment="Stretch"
                                              SelectionChanged="ResizeMode_SelectionChanged" AutomationProperties.Name="Como redimensionar">
                                        <ComboBoxItem Content="Manter o tamanho original" />
                                        <ComboBoxItem Content="Limitar o maior lado" />
                                        <ComboBoxItem Content="Definir a largura" />
                                        <ComboBoxItem Content="Definir a altura" />
                                        <ComboBoxItem Content="Usar uma porcentagem" />
                                        <ComboBoxItem Content="Caber em largura e altura" />
                                    </ComboBox>
                                    <NumberBox x:Name="ResizeValueBox" Header="Maior lado (pixels)" Value="1920"
                                               Minimum="1" Maximum="65536" SmallChange="1" LargeChange="100"
                                               SpinButtonPlacementMode="Compact" ValueChanged="Dimension_ValueChanged" Visibility="Collapsed" />
                                    <NumberBox x:Name="ResizeHeightBox" Header="Altura máxima (pixels)" Value="1080"
                                               Minimum="1" Maximum="65536" SmallChange="1" LargeChange="100"
                                               SpinButtonPlacementMode="Compact" ValueChanged="Dimension_ValueChanged" Visibility="Collapsed" />
                                    <CheckBox x:Name="EnlargeCheck" Checked="Setting_Changed" Unchecked="Setting_Changed">
                                        <TextBlock Text="Permitir ampliar imagens pequenas" TextWrapping="Wrap" />
                                    </CheckBox>
                                    <TextBlock Text="As proporções são preservadas, sem esticar ou cortar a imagem."
                                               FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                                </StackPanel>
                            </Expander>

                            <StackPanel Spacing="6">
                                <Button x:Name="BackgroundButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Rectangle Width="18" Height="18" RadiusX="4" RadiusY="4">
                                            <Rectangle.Fill><SolidColorBrush x:Name="BackgroundSwatch" Color="White" /></Rectangle.Fill>
                                        </Rectangle>
                                        <TextBlock Text="Cor de fundo" />
                                    </StackPanel>
                                    <Button.Flyout>
                                        <Flyout>
                                            <ColorPicker x:Name="BackgroundPicker" Color="White" IsAlphaEnabled="False"
                                                         IsAlphaSliderVisible="False" IsAlphaTextInputVisible="False"
                                                         ColorChanged="Background_ColorChanged" />
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                                <TextBlock x:Name="BackgroundHint" Text="Usada ao salvar sem transparência."
                                           FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                            </StackPanel>

                            <Rectangle Height="1" Fill="{StaticResource OutlineBrush}" />

                            <StackPanel Spacing="8">
                                <TextBlock Text="Salvar em" />
                                <TextBlock x:Name="FolderText" Text="Escolha uma pasta de destino"
                                           FontSize="12" Foreground="{StaticResource SubtleBrush}"
                                           TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" />
                                <Button x:Name="FolderButton" Content="Escolher pasta"
                                        HorizontalAlignment="Stretch" Click="Folder_Click" />
                            </StackPanel>

                            <StackPanel Spacing="10">
                                <CheckBox x:Name="RenameCheck" IsChecked="True" Checked="Setting_Changed" Unchecked="Setting_Changed">
                                    <TextBlock Text="Renomear automaticamente" TextWrapping="Wrap" />
                                </CheckBox>
                                <CheckBox x:Name="OpenFolderCheck" IsChecked="False" Checked="Setting_Changed" Unchecked="Setting_Changed">
                                    <TextBlock Text="Abrir a pasta ao terminar" TextWrapping="Wrap" />
                                </CheckBox>
                                <CheckBox x:Name="NotifyCheck" IsChecked="True" Checked="Setting_Changed" Unchecked="Setting_Changed">
                                    <TextBlock Text="Notificar pelo Windows ao terminar" TextWrapping="Wrap" />
                                </CheckBox>
                                <TextBlock Text="Se um nome já existir, adicionamos um número. Seus originais são preservados."
                                           FontSize="11" Foreground="{StaticResource SubtleBrush}" TextWrapping="Wrap" />
                            </StackPanel>

                            <Expander Header="Meus perfis" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <StackPanel Spacing="10">
                                    <ComboBox x:Name="ProfilesBox" PlaceholderText="Escolha um perfil" DisplayMemberPath="Name"
                                              HorizontalAlignment="Stretch" SelectionChanged="Profile_SelectionChanged" />
                                    <Button x:Name="SaveProfileButton" Content="Salvar ajustes como perfil" Click="SaveProfile_Click"
                                            HorizontalAlignment="Stretch" />
                                    <Button x:Name="DeleteProfileButton" Content="Excluir perfil selecionado" Click="DeleteProfile_Click"
                                            HorizontalAlignment="Stretch" IsEnabled="False" />
                                    <TextBlock Text="As últimas escolhas são lembradas automaticamente. Perfis guardam também a pasta de destino."
                                               FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                                </StackPanel>
                            </Expander>

                            <TextBlock Text="Em arquivos com várias páginas ou animação, será convertida apenas a primeira imagem."
                                       FontSize="11" Foreground="{StaticResource SubtleBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <Border Grid.Row="3" CornerRadius="16" Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource OutlineBrush}" BorderThickness="1" Padding="18">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="8" VerticalAlignment="Center">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="StatusText" Text="Preparando os formatos disponíveis…"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="TotalText" Grid.Column="1" Text="0%"
                                       Foreground="{StaticResource SubtleBrush}" />
                        </Grid>
                        <TextBlock x:Name="TotalsText" Text="Clique na miniatura para comparar antes e depois."
                                   FontSize="12" Foreground="{StaticResource SubtleBrush}" TextTrimming="CharacterEllipsis" />
                        <ProgressBar x:Name="TotalProgress" Minimum="0" Maximum="100" Value="0"
                                     AutomationProperties.Name="Progresso total do lote" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10"
                                VerticalAlignment="Center">
                        <FontIcon x:Name="SuccessIcon" Glyph="&#xE73E;" FontSize="24"
                                  Foreground="#9DE0B2" Visibility="Collapsed"
                                  AutomationProperties.Name="Conversão concluída" />
                        <Button x:Name="CancelButton" Content="Cancelar" Click="Cancel_Click"
                                Visibility="Collapsed" />
                        <Button x:Name="StartButton" Content="Converter imagens" Click="Start_Click"
                                Background="{StaticResource AccentBrush}" Foreground="#211635"
                                FontWeight="SemiBold" IsEnabled="False" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <Grid x:Name="StartupOverlay" Grid.RowSpan="2" Background="#15131D">
            <StackPanel x:Name="StartupBrand" MaxWidth="560" Margin="36,0"
                        HorizontalAlignment="Stretch" VerticalAlignment="Center"
                        RenderTransformOrigin="0.5,0.5">
                <StackPanel.RenderTransform>
                    <CompositeTransform x:Name="StartupBrandTransform" />
                </StackPanel.RenderTransform>
                <Image x:Name="StartupLogo" Source="ms-appx:///Assets/CarriolaLogo.png"
                       MaxWidth="520" MaxHeight="201" Stretch="Uniform"
                       HorizontalAlignment="Stretch"
                       AutomationProperties.Name="Carriola Images Converter" />
                <TextBlock Text="Suas imagens. Do seu jeito." FontSize="16"
                           Foreground="#ABA5B8" TextAlignment="Center"
                           TextWrapping="Wrap" Margin="0,24,0,0" />
                <ProgressRing x:Name="StartupProgress" Width="20" Height="20"
                              IsActive="True" Foreground="{StaticResource AccentBrush}"
                              HorizontalAlignment="Center" Margin="0,30,0,0"
                              AutomationProperties.Name="Abrindo o aplicativo" />
                <TextBlock x:Name="StartupStatus" Text="Abrindo seu espaço..."
                           FontSize="12" Foreground="#9690A3" Margin="0,18,0,0"
                           TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
